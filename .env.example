# --- LLM + embeddings (OpenRouter) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Chat models, tried in order until one returns content. Free ids get retired
# and share a rate-limited pool, so a chain is more reliable than one model.
# Leave blank for the built-in chain, or set LLM_MODEL to pin a single model.
LLM_MODEL=
LLM_MODELS=

# Retries for transient upstream failures (429 / 5xx / connection resets).
LLM_ATTEMPTS=2
EMBED_ATTEMPTS=4

# Embedding model used to build the vector index.
EMBED_MODEL=openai/text-embedding-3-small

# --- Analytics store (Supabase Postgres) ---
# Leave both blank to fall back to a local analytics.db sqlite file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Where the local sqlite fallback lives. On read-only filesystems (Vercel)
# analytics is skipped instead of failing the request.
ANALYTICS_DB_PATH=

# --- Local development only ---
# Set to "ollama" to run against a local Ollama instead of OpenRouter.
EMBEDDING_PROVIDER=openrouter
LLM_PROVIDER=openrouter
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2:3b