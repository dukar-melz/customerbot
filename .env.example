# --- LLM + embeddings (OpenRouter) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free-tier chat model. Any OpenRouter chat model id works.
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Embedding model used to build the vector index.
EMBED_MODEL=openai/text-embedding-3-small

# --- Analytics store (Supabase Postgres) ---
# Leave both blank to fall back to a local analytics.db sqlite file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Local development only ---
# Set to "ollama" to run against a local Ollama instead of OpenRouter.
EMBEDDING_PROVIDER=openrouter
LLM_PROVIDER=openrouter
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2:3b